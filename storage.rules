rules_version = '2';
// v395 : photos des machines (passeport, RAI). Comptes Google @enogia.com vérifiés, comme Firestore.
// Fichiers : machines/<préfixe beta_><PJ>/<id>.jpg et <id>_t.jpg (vignette) ; JPEG de moins de 4 Mo (compressés dans le navigateur).
// Publication par Gabriel : firebase deploy --only storage (après avoir activé Storage dans la console Firebase).
service firebase.storage {
  match /b/{bucket}/o {
    function enogia() {
      return request.auth != null && request.auth.token.email_verified == true
        && request.auth.token.email.lower().matches('.*@enogia[.]com$');
    }
    match /machines/{folder}/{file} {
      allow read: if enogia();
      allow create: if enogia() && request.resource.size < 4 * 1024 * 1024 && request.resource.contentType == 'image/jpeg';
      allow delete: if enogia();
    }
  }
}
